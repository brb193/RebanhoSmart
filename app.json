{
  "expo": {
    "name": "RebanhoSmart",
    "slug": "rebanho-smart",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#F8F9FF"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F8F9FF"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Permita que o RebanhoSmart use a câmera para fotografar o animal.",
          "photosPermission": "Permita que o RebanhoSmart acesse suas fotos para anexar um animal."
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    }
  }
}
